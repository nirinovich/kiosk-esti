#:kivy 2.3.1
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp

<ClientScreen>:
    name: "clients"
    MDBoxLayout:
        orientation: "horizontal"
        padding: [dp(40), dp(40), dp(40), dp(40)]
        spacing: dp(24)
        md_bg_color: get_color_from_hex("#F5F6FA")

        # --- Left: Client List ---
        MDCard:
            orientation: "vertical"
            size_hint_x: 0.45
            padding: dp(18)
            radius: [dp(24),]
            md_bg_color: get_color_from_hex("#FFFFFF")
            elevation: 2

            MDLabel:
                text: "Liste des Clients"
                font_size: "22sp"
                bold: True
                halign: "center"
                theme_text_color: "Primary"
                size_hint_y: None
                height: dp(40)

            MDScrollView:
                MDList:
                    id: client_list

        # --- Right: Client Form & Actions ---
        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 0.55
            spacing: dp(18)

            MDLabel:
                text: "Gestion des Clients"
                font_size: "28sp"
                bold: True
                halign: "center"
                theme_text_color: "Primary"
                size_hint_y: None
                height: dp(48)

            MDCard:
                orientation: "vertical"
                padding: dp(24)
                md_bg_color: get_color_from_hex("#FFFFFF")
                elevation: 2
                size_hint_y: None
                height: dp(250)

                MDGridLayout:
                    cols: 1
                    spacing: dp(18)
                    size_hint_y: None
                    height: dp(180)

                    MDTextField:
                        id: nom_input
                        MDTextFieldHintText:
                            text: "Nom du client"

                    MDTextField:
                        id: tel_input
                        input_filter: "int"
                        MDTextFieldHintText:
                            text: "Téléphone du client"

                    MDTextField:
                        id: adresse_input
                        MDTextFieldHintText:
                            text: "Adresse du client"

                MDButton:
                    style: "filled"
                    md_bg_color: get_color_from_hex("#1976D2")
                    pos_hint: {"center_x": 0.5}
                    on_release:
                        root.ajouter_client(nom_input.text, tel_input.text, adresse_input.text); nom_input.text = ""; tel_input.text = ""; adresse_input.text = ""
                    MDButtonText:
                        text: "Ajouter"

            MDLabel:
                text: root.message
                theme_text_color: "Error"
                font_size: "16sp"
                halign: "center"
                size_hint_y: None
                height: dp(28)

            MDBoxLayout:
                size_hint_y: None
                height: dp(56)
                spacing: dp(12)

                MDButton:
                    style: "filled"
                    md_bg_color: get_color_from_hex("#B71C1C")
                    on_release: root.manager.current = "home"
                    MDButtonText:
                        text: "Retour"
                    MDButtonIcon:
                        icon: "arrow-left"