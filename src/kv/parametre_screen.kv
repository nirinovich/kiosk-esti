#:kivy 2.3.1
#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import dp kivy.metrics.dp

<ParametreScreen>:
    name: "parametres"
    MDBoxLayout:
        orientation: "vertical"
        padding: [dp(40), dp(40), dp(40), dp(40)]
        spacing: dp(20)
        md_bg_color: get_color_from_hex("#F5F6FA")

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(48)
            MDButton:
                style: "filled"
                on_release: root.manager.current = "home"
                MDButtonText:
                    text: "Retour à l'accueil"
                    
                MDButtonIcon:
                    icon: "arrow-left"
        MDLabel:
            text: "Paramètres"
            font_size: "32sp"
            bold: True
            halign: "center"
            theme_text_color: "Primary"
            size_hint_y: None
            height: dp(60)

        MDCard:
            orientation: "vertical"
            padding: dp(32)
            size_hint: None, None
            size: dp(600), dp(380)
            elevation: 12
            radius: [24, 24, 24, 24]
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            md_bg_color: get_color_from_hex("#FFFFFF")
            spacing: dp(18)

            MDLabel:
                text: "Sécurité & Préférences"
                font_size: "20sp"
                bold: True
                halign: "center"
                theme_text_color: "Secondary"
                size_hint_y: None
                height: dp(36)
            Widget:
                size_hint_y: None
                height: dp(1)
                canvas:
                    Color:
                        rgba: get_color_from_hex("#E0E0E0")
                    Rectangle:
                        pos: self.pos
                        size: self.size

            MDGridLayout:
                cols: 2
                spacing: dp(20)
                size_hint_y: None
                height: dp(120)

                MDTextField:
                    id: new_password_input
                    hint_text: "Entrer un nouveau mot de passe sécurisé"
                    password: True
                    icon_left: "lock-reset"
                    mode: "outlined"
                    size_hint: 1, None
                    height: dp(56)
                    pos_hint: {"center_x": 0.5}

                MDButton:
                    style: "elevated"
                    md_bg_color: get_color_from_hex("#1976D2")
                    size_hint: 1, None
                    height: dp(56)
                    on_release: root.changer_mot_de_passe()
                    MDButtonIcon:
                        icon: "key-change"
                    MDButtonText:
                        text: "Changer le mot de passe"

                MDWidget:
                    size_hint: 1, None
                    height: dp(56)

                MDButton:
                    style: "outlined"
                    line_color: get_color_from_hex("#1976D2")
                    text_color: get_color_from_hex("#1976D2")
                    size_hint: 1, None
                    height: dp(56)
                    on_release: root.basculer_theme()
                    MDButtonIcon:
                        icon: "theme-light-dark"
                    MDButtonText:
                        text: "Thème : Clair/Sombre"

            MDLabel:
                text: "Informations"
                font_size: "20sp"
                bold: True
                halign: "center"
                theme_text_color: "Secondary"
                size_hint_y: None
                height: dp(36)
            Widget:
                size_hint_y: None
                height: dp(1)
                canvas:
                    Color:
                        rgba: get_color_from_hex("#E0E0E0")
                    Rectangle:
                        pos: self.pos
                        size: self.size

            MDLabel:
                text: "Utilisateur : {} (Rôle : {})".format(root.utilisateur_nom, root.utilisateur_role)
                theme_text_color: "Hint"
                font_size: "16sp"
                halign: "center"

            MDLabel:
                text: "Version : 1.0.0"
                theme_text_color: "Hint"
                font_size: "16sp"
                halign: "center"